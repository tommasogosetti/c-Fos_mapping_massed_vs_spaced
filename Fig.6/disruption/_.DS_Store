#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import copy
import networkx as nx





def purge_smaller_components(network, minimum_number_of_nodes_permitted): #minimum must be int and not lower than 2
    sorted_components = sorted(nx.connected_components(network), key=len, reverse=True)
    for i in range(0, len(sorted_components)):
        if len(sorted_components[i])<minimum_number_of_nodes_permitted:
            purged_network=network.subgraph(set().union(*sorted_components[0:i]))
            break
    return purged_network


def remove_nodes_by_ci_and_calculate_absolute_efficiency(unfrozen_network, number_of_iterations, filename, nodes_in_elimination_order):
    with open(filename, 'a') as f:
        f.write(str(unfrozen_network.name)+',')
    for i in range(0, number_of_iterations):
        if i==number_of_iterations-1:
            print(nx.global_efficiency(unfrozen_network))
            with open(filename, 'a') as f:
                f.write((str(nx.global_efficiency(unfrozen_network)))+'\n')
        else:
            print(nx.global_efficiency(unfrozen_network))
            with open(filename, 'a') as f:
                f.write((str(nx.global_efficiency(unfrozen_network)))+',')
                f.write(nodes_in_elimination_order[i]+':')
            unfrozen_network.remove_node(nodes_in_elimination_order[i])  ###il replace va messo perché non so per quale motivo la funzione per la lista nodi mi fa le liste con virgolette doppie ed è più comodo fixarlo qui che nel codice originale
        
def remove_nodes_by_ci_and_calculate_relative_efficiency(unfrozen_network, number_of_iterations, filename, nodes_in_elimination_order):
    with open(filename, 'a') as f:
        f.write(str(unfrozen_network.name)+',')
    original_efficiency=nx.global_efficiency(unfrozen_network)
    for i in range(0, number_of_iterations):
        if i==number_of_iterations-1:
            print(nx.global_efficiency(unfrozen_network)/original_efficiency)
            with open(filename, 'a') as f:
                f.write((str(nx.global_efficiency(unfrozen_network)/original_efficiency))+'\n')
        else:
            print(nx.global_efficiency(unfrozen_network)/original_efficiency)
            with open(filename, 'a') as f:
                f.write((str(nx.global_efficiency(unfrozen_network)/original_efficiency))+',')
                f.write(nodes_in_elimination_order[i]+':')
            unfrozen_network.remove_node(nodes_in_elimination_order[i])

def remove_nodes_by_ci_and_calculate_absolute_gc_dimension(unfrozen_network, number_of_iterations, filename, nodes_in_elimination_order):
    with open(filename, 'a') as f:
        f.write(str(unfrozen_network.name)+',')
    for i in range(0, number_of_iterations):
        if i==number_of_iterations-1:
            print(len(sorted(nx.connected_components(unfrozen_network), key=len, reverse=True)[0]))
            with open(filename, 'a') as f:
                f.write((str(len(sorted(nx.connected_components(unfrozen_network), key=len, reverse=True)[0]))+'\n'))
        else:
            print(len(sorted(nx.connected_components(unfrozen_network), key=len, reverse=True)[0]))
            with open(filename, 'a') as f:
                f.write((str(len(sorted(nx.connected_components(unfrozen_network), key=len, reverse=True)[0]))+','))
                f.write(nodes_in_elimination_order[i]+':')
            unfrozen_network.remove_node(nodes_in_elimination_order[i])

def remove_nodes_by_ci_and_calculate_relative_gc_dimension(unfrozen_network, number_of_iterations, filename, nodes_in_elimination_order):
    with open(filename, 'a') as f:
        f.write(str(unfrozen_network.name)+',')
    original_gc_dimension=float(len(sorted(nx.connected_components(unfrozen_network), key=len, reverse=True)[0]))
    for i in range(0, number_of_iterations):
        if i==number_of_iterations-1:
            print(float(len(sorted(nx.connected_components(unfrozen_network), key=len, reverse=True)[0]))/original_gc_dimension)
            with open(filename, 'a') as f:
                f.write((str(float(len(sorted(nx.connected_components(unfrozen_network), key=len, reverse=True)[0]))/original_gc_dimension))+'\n')
        else:
            print(float(len(sorted(nx.connected_components(unfrozen_network), key=len, reverse=True)[0]))/original_gc_dimension)
            with open(filename, 'a') as f:
                f.write((str(float(len(sorted(nx.connected_components(unfrozen_network), key=len, reverse=True)[0]))/original_gc_dimension))+',')
                f.write(nodes_in_elimination_order[i]+':')
            unfrozen_network.remove_node(nodes_in_elimination_order[i])                
                

def ottieni_liste_nodi_da_eliminare_ordinati(lista_csv):
    liste_nodi_ordinati={}
    for csv in lista_csv:
        with open(csv, 'r') as f:
            contenuto_csv=f.read().split('\n')[1:-1]
        dizionario_csv=dict(zip((x.split(',')[0] for x in contenuto_csv), (x.split(',')[1] for x in contenuto_csv)))
        dizionario_ordinato=sorted(dizionario_csv.items(), key=lambda x:int(x[1]), reverse=True)
        nodi_ordinati=[x[0] for x in dizionario_ordinato]
        liste_nodi_ordinati[csv]=nodi_ordinati
    return liste_nodi_ordinati


def ottieni_liste_nodi_da_eliminare_ordinati_CASO_PARTICOLARE_NUMERO_2(singolo_csv):
    with open(singolo_csv, 'r') as f:
        contenuto_csv=f.readlines()
    lista_ordinata_nodi = []
    counter=0
    for i in contenuto_csv:
        if counter == 0:
            counter = 1
        else:
            lista_ordinata_nodi.append(i.split('"')[1])
    return lista_ordinata_nodi


                
MC=nx.read_graphml("mcnet_0.65.graphml").to_undirected()
MC.name='MC'
MS=nx.read_graphml("msnet 0.65.graphml").to_undirected()
MS.name='MS'
SC=nx.read_graphml("scnet 0.65.graphml").to_undirected()
SC.name='SC'
SS=nx.read_graphml("ssnet 0.65 0.04.graphml").to_undirected()
SS.name='SS'



MC_d4_nodes = ottieni_liste_nodi_da_eliminare_ordinati_CASO_PARTICOLARE_NUMERO_2('nodes_by_ci_r0.65_p0.04/MC_ci_disruption_0.04_d4.csv')
MS_d4_nodes = ottieni_liste_nodi_da_eliminare_ordinati_CASO_PARTICOLARE_NUMERO_2('nodes_by_ci_r0.65_p0.04/MS_ci_disruption_0.04_d4.csv')
SC_d4_nodes = ottieni_liste_nodi_da_eliminare_ordinati_CASO_PARTICOLARE_NUMERO_2('nodes_by_ci_r0.65_p0.04/SC_ci_disruption_0.04_d4.csv')
SS_d4_nodes = ottieni_liste_nodi_da_eliminare_ordinati_CASO_PARTICOLARE_NUMERO_2('nodes_by_ci_r0.65_p0.04/SS_ci_disruption_0.04_d4.csv')



dizionario_d4 = {}
dizionario_d4['SS']=SS_d4_nodes
dizionario_d4['SC']=SC_d4_nodes
dizionario_d4['MS']=MS_d4_nodes
dizionario_d4['MC']=MC_d4_nodes
            
networks = [MC, MS, SC, SS]
networks_purgati=[]

for network in networks:
    nx.relabel_nodes(network, nx.get_node_attributes(network, 'shared name'), copy=False)
    ##### purga tutti i network #####
    network_purgato=purge_smaller_components(network, 5)
    network_purgato_scongelato=nx.Graph(network_purgato)
    networks_purgati.append(network_purgato_scongelato)
    for key in list(dizionario_d4.keys()):
        if key==network.name:
            ricopia1=copy.deepcopy(network)
            remove_nodes_by_ci_and_calculate_relative_gc_dimension(ricopia1, 30, '065_ci_d4_relative_gc.csv', dizionario_d4[key])


                
                